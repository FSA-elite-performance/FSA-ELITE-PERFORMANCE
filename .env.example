# FSA ELITE Sales App — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any real secrets to version control.

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Your Stripe SECRET key (server-side only — never expose to the browser)
# Obtain from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Your Stripe PUBLISHABLE key (safe to expose in the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ─── App URL ─────────────────────────────────────────────────────────────────
# Full base URL used for Stripe redirect URLs (success / cancel).
# Local development:
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Vercel Production (before custom domain cutover), for example:
# NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app
# Vercel Production (after cutover):
# NEXT_PUBLIC_BASE_URL=https://fsaeliteperformance.com
# Optional on Preview and Development. If unset, checkout routes infer host from request headers.
NEXT_PUBLIC_BASE_URL=https://fsaeliteperformance.com

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV=development

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Base URL for the OpenAI-compatible AI API. Defaults to dedaluslabs.ai.
# Set to https://api.openai.com/v1 to use OpenAI directly.
AI_API_BASE_URL=https://api.dedaluslabs.ai/v1

# ─── OpenAI (AI Roleplay) ────────────────────────────────────────────────────
# Required for the AI-powered sales roleplay feature (/roleplay).
# When using dedaluslabs.ai (default), obtain your key from the dedaluslabs dashboard.
# When using OpenAI directly, obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_replace_me

# Optional: OpenAI project ID for OLIVE and other FSA AI features.
# Example: OPENAI_PROJECT_ID=proj_giuCPJ5mn3eEL5zqHUVWTgTV
OPENAI_PROJECT_ID=

# Optional: Prompt Library ID to use as the server-side system prompt.
# If set, the AI route will call the Responses API with this prompt ID and
# pass the conversation as input. Leave blank to use the built-in SYSTEM_PROMPT.
OPENAI_PROMPT_ID=

# Optional: display name for the FSA AI assistant.
# Default: OLIVE
OLIVE_ASSISTANT_NAME=OLIVE

# ─── AI API base URL (OpenAI-compatible endpoint) ────────────────────────────
# Defaults to dedaluslabs.ai for cost-efficient openai/gpt-5 access.
# Set to https://api.openai.com/v1 to use OpenAI directly instead.
# Note: OPENAI_PROMPT_ID (Responses API) is only used when this is unset.
AI_API_BASE_URL=https://api.dedaluslabs.ai/v1

# Toggle to make the Roleplay Lab public to all visitors. Set to `true` or `1`
# to allow open access without membership checks. Default: `false` (members-only).
NEXT_PUBLIC_ROLEPLAY_PUBLIC=false

# ─── Stripe training checkout ────────────────────────────────────────────────
# Optional but recommended: create a Stripe Price for the full training course
# and paste the Price ID here. If omitted, the app creates the $12.99 one-time
# training price on the fly using server-side `price_data`.
# STRIPE_TRAINING_PRICE_ID=price_1Abc123...
# Backward-compatible fallback key (older config):
# STRIPE_PRICE_ID=price_1Abc123...
# Optional: reserved Stripe `mk_...` identifier for future FSA-specific integration.
# STRIPE_MK_ID=mk_...

# ─── BotID route protection (optional) ───────────────────────────────────────
# Optional: comma-separated trusted frontend domains for BotID-protected routes
# when frontend and API can be served from different hosts.
# Example: BOTID_EXTRA_ALLOWED_HOSTS=fsaeliteperformance.com,fsaelite.org
BOTID_EXTRA_ALLOWED_HOSTS=

# Optional allowlists for verified bots on AI chat route.
# Matching is case-insensitive and comma-separated.
# BOTID_ALLOWED_VERIFIED_BOT_NAMES=chatgpt-operator
# BOTID_ALLOWED_VERIFIED_BOT_CATEGORIES=ai-assistant

# Optional signing secret for server-issued membership cookies.
# If omitted, the app falls back to STRIPE_SECRET_KEY, but a dedicated secret is recommended.
# MEMBERSHIP_SIGNING_SECRET=replace-with-a-long-random-secret

# ─── Session auth (login gate) ───────────────────────────────────────────────
# HMAC secret used to sign the fsaelite_session cookie (Edge-compatible).
# Falls back to MEMBERSHIP_SIGNING_SECRET → STRIPE_SECRET_KEY if unset, but a
# dedicated secret is strongly recommended for production.
# SESSION_SIGNING_SECRET=replace-with-a-long-random-secret

# ─── Firebase Authentication ────────────────────────────────────────────────
# Client-side config (safe to expose in the browser).
# Obtain from Firebase Console → Project settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Server-side Firebase Admin credentials (NEVER expose these to the browser).
# Obtain from Firebase Console → Project settings → Service accounts → Generate new private key.
# The private key must have literal \n characters (not newlines) in env var form.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="<paste-your-private-key-here>"

# Optional: configure the Firebase Console → Authentication → Email Templates
# "Action URL" to https://fsaeliteperformance.com/reset-password
# so password-reset emails redirect to the custom FSA ELITE reset page.
