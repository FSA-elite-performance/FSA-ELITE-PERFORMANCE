# =============================================================
# FSA Elite — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
#
# Local:   cp .env.example .env.local
# Vercel:  Set these in your Vercel project → Settings → Environment Variables
# =============================================================

# Stripe Secret Key (server-side only — never expose in frontend)
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for testing, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe Publishable Key (safe to expose in frontend)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Base URL of your deployment (no trailing slash)
# Local dev:  http://localhost:3000
# Vercel:     https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Price in cents (e.g. 9700 = $97.00)
# This is the one-time early-access price for FSA Elite
PRICE_AMOUNT_CENTS=9700

# (Optional) Stripe Webhook Secret — required for server-side payment verification
# Get from: https://dashboard.stripe.com/webhooks after creating a webhook endpoint
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
