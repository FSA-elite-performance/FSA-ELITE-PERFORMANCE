# FSA Elite — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Stripe Secret Key (server-side ONLY — never expose this publicly)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (safe for browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Your deployed base URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Price in cents (e.g. 4997 = $49.97)
PRICE_AMOUNT_CENTS=4997
