# ─────────────────────────────────────────────────────────────────────────────
# FSA Elite — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secret keys.
# ─────────────────────────────────────────────────────────────────────────────

# Stripe Secret Key — starts with sk_test_ (test) or sk_live_ (production)
# Find this at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Stripe Publishable Key — starts with pk_test_ (test) or pk_live_ (production)
# This key is safe to expose in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Base URL of your deployed application (no trailing slash)
# Examples:
#   Local dev:    http://localhost:3000
#   Vercel:       https://fsa-elite.vercel.app
#   Custom domain: https://fsaeliteperformance.org
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Price in cents for the FSA Elite Early Access product
# Example: 9700 = $97.00 USD
PRICE_AMOUNT_CENTS=9700
