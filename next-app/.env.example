# FSA Elite — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any real secrets to version control.

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Your Stripe SECRET key (server-side only — never expose to the browser)
# Obtain from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Your Stripe PUBLISHABLE key (safe to expose in the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── App URL ─────────────────────────────────────────────────────────────────
# Full base URL used for Stripe redirect URLs (success / cancel).
# Local development:
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production (Vercel / custom domain):
NEXT_PUBLIC_BASE_URL=https://fsaeliteperformance.org

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Stripe subscriptions (optional — future) ────────────────────────────────
# To switch from one-time payment to a subscription, create a recurring Price
# in Stripe Dashboard and paste the Price ID here.  Then update the API route
# to use `price: process.env.STRIPE_PRICE_ID` and `mode: 'subscription'`.
# STRIPE_PRICE_ID=price_1Abc123...
